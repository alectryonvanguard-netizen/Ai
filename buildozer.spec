[app]
title = QYRONEX AI
package.name = qyronexai
package.domain = org.qyronex
source.dir = .
source.include_exts = py,png,json,kv,txt
version = 0.2.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET
android.api = 35
android.minapi = 23
android.archs = arm64-v8a, armeabi-v7a

[buildozer]
log_level = 2
warn_on_root = 1
